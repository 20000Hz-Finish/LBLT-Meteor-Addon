{
  "schemaVersion": 1,
  "id": "lblt-meteor-addon",
  "version": "${version}",
  "name": "LBLT Meteor Addon",
  "description": "LBLT Meteor Addon - by 20000Hz",
  "authors": [
    "20000Hz"
  ],
  "contact": {},
  "icon": "assets/template/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.example.addon.LBLTAddon"
    ],
    "client": [
